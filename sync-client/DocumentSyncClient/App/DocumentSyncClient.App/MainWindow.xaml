<Window x:Class="DocumentSyncClient.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DocumentSyncClient.App"
        mc:Ignorable="d"
        Title="Document Sync Client" Height="520" Width="760">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
            <TextBlock Text="Document Sync Client" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding Status}" Margin="0,0,0,16" TextWrapping="Wrap"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
            <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
            <CheckBox IsChecked="{Binding RememberLogin}" Content="Remember me" Margin="0,0,0,16"/>
            <Button Content="Sign In" Command="{Binding SignInCommand}" IsDefault="True" Height="32"/>
            <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="6" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</Window>
