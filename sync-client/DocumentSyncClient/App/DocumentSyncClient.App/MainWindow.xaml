<Window x:Class="DocumentSyncClient.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SchoolDMS Sync"
        Height="760"
        Width="1040"
        MinHeight="640"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        Closing="Window_OnClosing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#243247" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Margin" Value="0,5,0,12" />
            <Setter Property="BorderBrush" Value="#D5DEEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Margin" Value="0,5,0,12" />
            <Setter Property="BorderBrush" Value="#D5DEEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#D5DEEA" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,8" />
            <Setter Property="Foreground" Value="#34445A" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#173B67" Padding="34">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="SchoolDMS" Foreground="White" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Desktop Sync" Foreground="#BFD7F5" FontSize="16" Margin="0,7,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Border Background="#245487" CornerRadius="12" Padding="18" Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="Your files, always available" Foreground="White" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="The web workspace remains the persistent source for your documents. The desktop app keeps working in the background when the laptop is online." Foreground="#DCEBFA" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Secure queue" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="Changes are queued locally and retried automatically when the connection returns." Foreground="#BFD7F5" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,18" />
                    <TextBlock Text="Background mode" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="Closing this window keeps synchronization running in the system tray. Use Exit from the tray menu to stop the client." Foreground="#BFD7F5" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="SchoolDMS document synchronization" Foreground="#BFD7F5" FontSize="11" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="38,30,38,28" MaxWidth="680">
                <TextBlock Text="Connect your desktop" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Sign in once, choose your folders, and keep synchronization running in the background." Foreground="#65758B" FontSize="14" Margin="0,7,0,24" TextWrapping="Wrap" />

                <Border Background="White" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Account" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Your password is used only for sign-in and is not stored by the desktop client." Foreground="#65758B" FontSize="12" Margin="0,5,0,14" TextWrapping="Wrap" />
                        <TextBlock Text="Email" FontSize="12" Foreground="#65758B" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Password" FontSize="12" Foreground="#65758B" />
                        <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_OnPasswordChanged" />
                        <CheckBox IsChecked="{Binding RememberLogin}" Content="Remember account and restore it automatically on startup" />
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Connection" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Server URL" FontSize="12" Foreground="#65758B" Margin="0,14,0,0" />
                        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="The server stores the web copy independently from your laptop." Foreground="#65758B" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Sync target folders" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Only these selected folders and their real local subfolders are synchronized. Files elsewhere on the drive are ignored." Foreground="#65758B" FontSize="12" Margin="0,5,0,14" TextWrapping="Wrap" />
                        <TextBlock Text="Primary target folder" FontSize="12" Foreground="#65758B" />
                        <DockPanel Margin="0,5,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseFolderCommand}" Margin="10,0,0,0" />
                            <TextBox Text="{Binding SyncFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ExtraFolders}" Margin="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F7F9FC" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="6" Padding="9,5" Margin="0,0,0,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Remove" Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="9,5" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Add another target folder" Command="{Binding AddFolderCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="Each laptop target is registered with its own Device ID. Removing one target stops only that target on this laptop; it does not delete the web folder." Foreground="#65758B" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Background behavior" FontSize="16" FontWeight="SemiBold" />
                        <CheckBox IsChecked="{Binding AutoSync}" Content="Synchronize changes automatically" />
                        <CheckBox IsChecked="{Binding AutoStartWindows}" Content="Start the sync client with Windows" />
                        <TextBlock Text="Closing the window minimizes the app to the system tray. Background sync stops only when you choose Exit from the tray menu." Foreground="#65758B" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Sign in" Width="120" Background="#1E73BE" Foreground="White" Command="{Binding SignInCommand}" />
                    <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" />
                </StackPanel>

                <Border Background="#EAF2FB" BorderBrush="#B9D5F2" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,4,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#9AA5B1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                                                <Setter Property="Fill" Value="#2E9E5B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="Connection status" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding StatusLine}" TextWrapping="Wrap" FontSize="13" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#65758B" FontSize="12" Margin="0,5,0,0" />
                        <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="5" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
