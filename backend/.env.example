# Salin ke .env dan isi nilai sebenar

# === Wajib ===
# PostgreSQL — guna Supabase Postgres (percuma) atau Neon:
# Untuk backend yang berjalan terus seperti Railway, pilih **Session pooler**
# (Supabase Connect → Session pooler, port 5432), bukan Transaction pooler
# port 6543. Tambahkan sslmode=require.
DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Disarankan untuk Prisma migrate deploy. Gunakan Direct connection jika
# Railway dapat menjangkaunya; jika tidak, gunakan URI Session pooler yang sama
# seperti DATABASE_URL. Jangan gunakan transaction pooler :6543 untuk migrasi.
DIRECT_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth + Storage
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# === Pilihan ===
# Port (Render set PORT=10000)
PORT=3000

# Pemacu storan fail: local (default) | supabase (tahan lama di hosting percuma)
STORAGE_DRIVER=local
# Laluan storan lokal (dipakai bila STORAGE_DRIVER=local)
STORAGE_PATH=./storage
# Nama bucket Supabase Storage (dipakai bila STORAGE_DRIVER=supabase)
SUPABASE_STORAGE_BUCKET=dms-files

# Had saiz fail upload dalam MB (contoh 50)
MAX_FILE_SIZE=50

# Domain web yang dibenarkan CORS (pisah koma). Contoh:
# ALLOWED_ORIGINS=http://localhost:3000,https://schooldms.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# === Google Drive (pilihan — tanpanya ciri Drive dilumpuhkan) ===
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REDIRECT_URI=
# DRIVE_TOKEN_ENCRYPTION_KEY=generate-a-long-random-secret
# DRIVE_OAUTH_STATE_SECRET=generate-a-different-long-random-secret
# URL frontend untuk redirect setelah OAuth selesai
WEB_APP_URL=https://school-dms.vercel.app

# Production checklist: use HTTPS, keep service-role and Drive secrets server-only,
# run Prisma migrations before deploy, and set ALLOWED_ORIGINS to exact trusted origins.
